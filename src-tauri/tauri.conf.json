{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChaChaanTeng",
  "version": "0.2.0",
  "identifier": "com.chachaanteng",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChaChaanTeng",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"]
  },
  "plugins": {
